generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  username  String     @unique
  password  String
  role      String     @default("ADMIN")
  firstName String
  lastName  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  about     About?
  blogPosts BlogPost[] @relation("BlogAuthor")
  projects  Project[]  @relation("ProjectCreator")
  resume    Resume?

  @@map("users")
}

model Project {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  description  String
  category     String   @default("SOFTWARE")
  technologies String   @default("[]")
  githubUrl    String?
  demoUrl      String?
  imageUrl     String?
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  Int
  createdBy    User     @relation("ProjectCreator", fields: [createdById], references: [id])

  @@index([category])
  @@index([published])
  @@index([featured])
  @@map("projects")
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  category    String   @default("TECHNOLOGY")
  imageUrl    String?
  author      String
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int
  createdBy   User     @relation("BlogAuthor", fields: [createdById], references: [id])

  @@index([category])
  @@index([published])
  @@index([createdAt])
  @@map("blog_posts")
}

model SocialMedia {
  id        Int      @id @default(autoincrement())
  platform  String   @unique
  name      String
  url       String
  icon      String?
  followers Int      @default(0)
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("social_media")
}

model Resume {
  id             Int             @id @default(autoincrement())
  userId         Int             @unique
  fullName       String
  title          String
  email          String
  phone          String?
  location       String?
  website        String?
  github         String?
  linkedin       String?
  summary        String
  profileImage   String?
  isPublic       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  certifications Certification[]
  educations     Education[]
  experiences    Experience[]
  interests      Interest[]
  languages      Language[]
  user           User            @relation(fields: [userId], references: [id])

  @@map("resumes")
}

model Experience {
  id           Int       @id @default(autoincrement())
  resumeId     Int
  company      String
  position     String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean   @default(false)
  description  String
  technologies String    @default("[]")
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resume       Resume    @relation(fields: [resumeId], references: [id])

  @@map("experiences")
}

model Education {
  id          Int       @id @default(autoincrement())
  resumeId    Int
  institution String
  degree      String
  field       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resume      Resume    @relation(fields: [resumeId], references: [id])

  @@map("educations")
}

model Certification {
  id           Int       @id @default(autoincrement())
  resumeId     Int
  name         String
  issuer       String
  date         DateTime?
  expiryDate   DateTime?
  credentialId String?
  url          String?
  logo         String?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resume       Resume    @relation(fields: [resumeId], references: [id])

  @@map("certifications")
}

model Language {
  id          Int      @id @default(autoincrement())
  resumeId    Int
  name        String
  proficiency String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resume      Resume   @relation(fields: [resumeId], references: [id])

  @@map("languages")
}

model Interest {
  id        Int      @id @default(autoincrement())
  resumeId  Int
  name      String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resume    Resume   @relation(fields: [resumeId], references: [id])

  @@map("interests")
}

model About {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  fullName     String   @default("")
  title        String   @default("")
  bio          String   @default("")
  location     String?  @default("")
  profileImage String?
  githubUrl    String?  @default("")
  linkedinUrl  String?  @default("")
  twitterUrl   String?  @default("")
  leetcodeUrl  String?  @default("")
  journey      String   @default("[]")
  skills       String   @default("[]")
  achievements String   @default("[]")
  stats        String   @default("[]")
  strengths    String   @default("[]")
  expertise    String   @default("[]")
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@map("about")
}
